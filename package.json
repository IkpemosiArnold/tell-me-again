{
  "name": "tell-me-again",
  "version": "0.1.0",
  "private": true,
  "description": "Record an elder's stories, transcribe them on the device, and let open Gemma turn them into a small family story book. Nothing leaves the phone by default.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@wllama/wllama": "3.8.1",
    "mediabunny": "^1.61.5",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "playwright-core": "1.64.1",
    "vite": "6.3.5"
  }
}
